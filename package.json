{
  "name": "nishiki",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Private login-protected AI assistant with Google Calendar, text-to-speech and thinking orbs",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "concurrently -n server,client \"node --env-file-if-exists=.env --watch server/index.js\" \"vite --config client/vite.config.js\"",
    "build": "vite build --config client/vite.config.js",
    "start": "node --env-file-if-exists=.env server/index.js",
    "user:add": "node --env-file-if-exists=.env scripts/create-user.js",
    "user:passwd": "node --env-file-if-exists=.env scripts/create-user.js --reset"
  },
  "dependencies": {
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/shippori-mincho": "^5.3.0",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-switch": "^1.4.1",
    "@radix-ui/react-tabs": "^1.2.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "@tailwindcss/vite": "^4.3.5",
    "@yogesharc/thinking-orbs": "^0.1.2",
    "express": "^5.3.0",
    "express-rate-limit": "^7.5.0",
    "helmet": "^8.0.0",
    "highlight.js": "^11.12.0",
    "imapflow": "^1.7.8",
    "jszip": "3.10.2",
    "lowlight": "^3.3.0",
    "lucide-react": "^1.73.0",
    "mammoth": "1.13.0",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "6.4.299",
    "pptxgenjs": "4.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "recharts": "^3.10.1",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "sonner": "^2.0.8",
    "tailwindcss": "^4.3.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^9.1.0",
    "vite": "^7.3.8"
  }
}
