# Copy to .env (never commit .env). Values are read by the server only.

# Address the browser uses. Must be the HTTPS URL in production.
PUBLIC_URL=http://localhost:8787
HOST=127.0.0.1
PORT=8787

# Name the assistant uses for itself
ASSISTANT_NAME=Nishiki

# --- AI: Hack Club AI is the only provider. Pick the models in Settings → Admin → AI models. ---
# Create a key in the Hack Club AI dashboard (https://ai.hackclub.com).
HACKCLUB_API_KEY=
HACKCLUB_BASE_URL=https://ai.hackclub.com/proxy/v1
# Starting chat model. Any id from GET https://ai.hackclub.com/proxy/v1/models can be chosen later in the admin page.
HACKCLUB_MODEL=~deepseek/deepseek-flash-latest
# Model for voice mode answers (fast, same price as Haiku):
VOICE_MODEL=openai/gpt-6-luna
AI_MAX_TOKENS=3000
# Limits per reply and per request. Nothing is limited per day per person.
# All model tokens one reply may use, across its tool steps:
AI_MAX_TURN_TOKENS=40000
# Tool result sent back to the model, per tool call (characters):
TOOL_OUTPUT_CHARS=8000
# How much of a chat is sent per reply (characters). Older parts are summarized, not dropped.
HISTORY_CHARS=20000
# Photos and PDFs sent as data per request (bytes):
ATTACHMENT_BYTES_PER_REQUEST=8388608

# --- Google Calendar (OAuth web client) ---
# Redirect URI to register at Google: ${PUBLIC_URL}/api/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
ENCRYPTION_KEY=

# --- Server voice: audio-output model on Hack Club AI (same key) ---
# TTS_ENABLED=0 uses the browser voice instead.
# Speech-to-text model (WAV audio in, text out)
STT_MODEL=mistralai/voxtral-small-24b-2507
TTS_ENABLED=1
TTS_MODEL=openai/gpt-audio-mini
TTS_VOICE=alloy

# Time zone for "today" and "tomorrow", as an IANA name, e.g. Europe/Berlin.
# Defaults to the zone of the server.
# TIMEZONE=Europe/Berlin

# Phone notifications: the public ntfy server, or your own
# NTFY_URL=https://ntfy.sh
# Set to 0 to switch off background checks (mail report)
# SCHEDULER=1

# Where the SQLite database and any local state live
DATA_DIR=data

# Room for uploaded photos and PDFs, in MB, shared by everyone. Files are kept in DATA_DIR/files.
STORAGE_LIMIT_MB=500
DEEP_MODEL=anthropic/claude-haiku-5.5
VOICE_DAILY_TURNS=80

VOICE_ENABLED=0
